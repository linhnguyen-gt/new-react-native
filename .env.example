# This is an example environment file
# Copy this file to .env, .env.staging, or .env.production and update the values.
#
# The shared values live in EAS (expo.dev). Pull them instead of filling this in by hand:
#   pnpm env:pull            # every variant
#   pnpm env:pull staging    # one variant
#
# Keep every variable at "plaintext" or "sensitive" visibility in EAS. `eas env:exec` refuses
# to read "secret" values outside EAS's own servers, and app.config.ts needs all of them while
# it resolves.
#
# Two rules this file has to follow, both enforced at runtime:
#
# 1. Never put a `#` comment at the end of a value line. Keep comments on their own line.
#    The env parser strips a trailing comment but react-native-config keeps everything after `=` on
#    both platforms, so `APP_FLAVOR=development # note` reaches native code as
#    "development # note". src/shared/config/environment.ts compares the two sources and throws.
#
# 2. Never leave a variable empty. app.config.ts rejects any empty value, so delete the line
#    instead of assigning nothing to it.
#
# APP_FLAVOR must also match the APP_ENV used to build: .env -> development,
# .env.staging -> staging, .env.production -> production.

# Environment: development | staging | production
APP_FLAVOR=development

# App Configuration
APP_NAME=MyApp

# Version
VERSION_CODE=1
VERSION_NAME=1.0.0

# API Configuration
API_URL=http://localhost:3000

# Optional. Identifies your own EAS project, created with `pnpm dlx eas-cli init`. The template
# deliberately ships no project id — see the README. Leave it out and the app still builds; it is
# only needed by the EAS sync commands.
# EXPO_PROJECT_ID=

# Add your other environment variables below. Every one of them is compiled into the native
# binary by react-native-config (Android BuildConfig, iOS Info.plist) and into the JS bundle by
# app.config.ts, so treat them all as publicly readable — never put real secrets here.
