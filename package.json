{
    "name": "NewReactNative",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "android": "node scripts/detect-package-manager.js && npx expo run:android --variant devDebug --device",
        "android:stg": "node scripts/detect-package-manager.js && APP_ENV=staging npx expo run:android --variant stagingDebug --app-id com.newreactnative.stg --device",
        "android:pro": "node scripts/detect-package-manager.js && APP_ENV=production npx expo run:android --variant productionDebug --app-id com.newreactnative.production --device",
        "ios": "node scripts/detect-package-manager.js && npx expo run:ios --device",
        "ios:stg": "node scripts/detect-package-manager.js && APP_ENV=staging npx expo run:ios --scheme Staging --configuration Staging.Debug --device",
        "ios:prod": "node scripts/detect-package-manager.js && APP_ENV=production npx expo run:ios --scheme Product --configuration Product.Debug --device",
        "check:env": "node scripts/check-env.js",
        "lint": "eslint .",
        "start": "npx expo start",
        "lint:fix": "eslint . --fix",
        "test": "jest",
        "clear:cache": "rm -rf node_modules && node scripts/pm-run.js install && watchman watch-del-all && del %localappdata%Temphaste-map-* && del %localappdata%Tempmetro-cache && npx expo start --clear",
        "clear:expo": "npx expo start --clear",
        "env:push": "dotenv-vault push && dotenv-vault push staging && dotenv-vault push production",
        "env:pull": "dotenv-vault pull && dotenv-vault pull staging && dotenv-vault pull production",
        "env:setup": "node scripts/setup-env.js",
        "adb:reactotron": "adb reverse tcp:9090 tcp:9090",
        "update-versions": "node scripts/update-readme-versions.js",
        "postinstall": "lefthook install && node scripts/pm-run.js update-versions",
        "doctor": "npx expo-doctor"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.5.7",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-vector-icons/ant-design": "^13.1.2",
        "@react-native-vector-icons/common": "^13.0.1",
        "@react-native-vector-icons/entypo": "^13.1.2",
        "@react-native-vector-icons/evil-icons": "^13.1.2",
        "@react-native-vector-icons/feather": "^13.1.2",
        "@react-native-vector-icons/ionicons": "^13.1.2",
        "@react-native-vector-icons/material-icons": "^13.1.2",
        "@react-native/new-app-screen": "0.86.2",
        "@react-navigation/native": "^7.3.14",
        "@react-navigation/stack": "^7.10.17",
        "@reduxjs/toolkit": "^2.12.0",
        "@shopify/flash-list": "2.0.2",
        "axios": "1.19.0",
        "dotenv": "^17.4.2",
        "expo": "~57.0.9",
        "expo-constants": "~57.0.8",
        "expo-font": "~57.0.1",
        "lodash": "^4.18.1",
        "nativewind": "^4.2.6",
        "react": "19.2.3",
        "react-hook-form": "^7.83.0",
        "react-native": "0.86.2",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-worklets": "0.10.1",
        "react-redux": "^9.3.0",
        "reactotron-react-native": "^5.2.0",
        "reactotron-redux": "^3.2.1",
        "reactotron-redux-saga": "^4.2.3",
        "redux": "^5.0.1",
        "redux-saga": "^1.5.1",
        "tailwindcss": "^3.4.17",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.25.3",
        "@babel/runtime": "^7.25.0",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^9.39.5",
        "@expo/metro-config": "~57.0.7",
        "@react-native-community/cli": "^20.2.0",
        "@react-native-community/cli-platform-android": "^20.2.0",
        "@react-native-community/cli-platform-ios": "^20.2.0",
        "@react-native/babel-preset": "0.86.2",
        "@react-native/eslint-config": "0.86.2",
        "@react-native/jest-preset": "0.86.2",
        "@react-native/metro-config": "0.86.2",
        "@react-native/typescript-config": "0.86.2",
        "@testing-library/react-native": "^14.0.1",
        "@types/jest": "^29.5.14",
        "@types/lodash": "^4.17.24",
        "@types/react": "^19.2.17",
        "@types/react-dom": "~19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "babel-preset-expo": "~57.0.5",
        "dotenv-vault": "^1.26.2",
        "eslint": "^9.39.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-native": "^5.0.0",
        "globals": "^17.8.0",
        "jest": "^29.7.0",
        "lefthook": "^2.1.10",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react-dom": "19.2.3",
        "test-renderer": "^1.2.0",
        "typescript": "~6.0.3"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "engines": {
        "node": "^22.22.1 || ^24.3.0 || >= 25.0.0"
    },
    "packageManager": "pnpm@11.18.0"
}
