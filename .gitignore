# Continuous Native Generation: ios/ and android/ are build output, regenerated from
# app.config.ts and plugins/ by `expo prebuild`. Do not commit them — an edit made directly
# in either directory is silently discarded on the next prebuild.
/ios/
/android/

# Working notes for a change in progress, not a description of the result. docs/ is tracked:
# README links into it, and a fork needs it to understand the tree.
plans/

